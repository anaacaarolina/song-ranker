VITE_SPOTIFY_CLIENT_ID = your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URL = http://127.0.0.1:8000/callback
VITE_SCOPES = playlist-read-private playlist-modify-public playlist-modify-private

# Server-side only — used by the preview-finder middleware (never exposed to the browser).
SPOTIFY_CLIENT_ID = your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET = your_spotify_client_secret_here